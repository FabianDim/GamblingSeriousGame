.game-screen {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    min-height: 0;
}

.game-screen #base-page-title {
    display: none;
}

.game-screen #base-page-scroll {
    display: none;
}

.gameplay-scene {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
    min-width: 0;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-bottom: 16px;
}

.gameplay-background {
    flex-shrink: 0;
    overflow: hidden;
}

.gameplay-pet {
    position: absolute;
    width: 40%;
    height: 30%;
    left: 30%;
    bottom: 12%;
}
