.home-page { flex-grow: 1; width: 100%; height: 100%; min-height: 0; }
.home-page .content-panel { padding-top: 24px; padding-bottom: 16px; }
.home-page .page-scroll { margin-top: 18px; }
.home-content { flex-shrink: 0; padding-bottom: 12px; }
.home-content Label { white-space: normal; flex-shrink: 0; }
.home-eyebrow { color: var(--app-primary); font-size: 10px; letter-spacing: 1px; margin-bottom: 6px; }
.home-heading { font-size: 27px; -unity-font-style: bold; margin-top: 6px; }
.home-intro { color: var(--app-text-muted); font-size: 14px; margin-top: 8px; margin-bottom: 22px; }
.home-card { flex-shrink: 0; border-radius: 20px; border-width: 1px; border-color: var(--app-outline); background-color: #131B28; padding: 18px; margin-bottom: 16px; }
.usage-card { border-color: #315247; background-color: #111F23; }
.home-row { flex-direction: row; align-items: center; }
.usage-heading-row { justify-content: space-between; flex-wrap: wrap; }
.home-section-title { font-size: 18px; -unity-font-style: bold; }
.home-content .usage-badge { color: #B9C9C7; background-color: #243737; border-radius: 8px; font-size: 10px; padding: 5px 8px; margin-top: 4px; margin-bottom: 4px; }
.home-content .usage-badge--example { color: #E9D29B; background-color: #3A3224; }
.usage-eyebrow { color: #9BB4AF; font-size: 10px; letter-spacing: 1px; margin-top: 8px; }
.usage-periods { flex-direction: row; background-color: #0B171B; border-radius: 12px; padding: 4px; margin-top: 18px; }
.usage-period { flex-grow: 1; flex-basis: 0; min-width: 0; min-height: 44px; margin: 0; border-width: 1px; border-color: transparent; border-radius: 9px; background-color: transparent; color: #BCC9C9; font-size: 13px; }
.usage-period:hover { background-color: #243737; }
.usage-period--selected { background-color: #2B443D; color: #C5FFDE; }
.usage-period:focus { border-color: var(--app-focus); }
.home-content .usage-total { font-size: 46px; -unity-font-style: bold; color: white; margin-top: 18px; }
.usage-summary { font-size: 13px; color: #BCC9C9; margin-top: 2px; }
.home-content .usage-status { font-size: 13px; color: #BECBCB; margin-top: 16px; }
.usage-chart-section { margin-top: 20px; display: none; }
.usage-chart { flex-direction: row; height: 132px; margin-top: 12px; }
.usage-day { flex-grow: 1; flex-basis: 0; min-width: 0; align-items: center; margin: 0 2px; }
.usage-bar-track { height: 88px; width: 100%; max-width: 24px; justify-content: flex-end; border-radius: 5px; background-color: #1C3032; }
.usage-bar { width: 100%; border-radius: 5px; background-color: #57DDA0; }
.home-content .usage-day-label { font-size: 9px; color: #B8C8C6; margin-top: 6px; }
.home-content .usage-day-value { font-size: 9px; color: #E1EEEA; margin-top: 3px; }
.usage-app-section { display: none; margin-top: 20px; }
.usage-app-row { flex-direction: row; align-items: center; padding: 12px 0; border-bottom-width: 1px; border-bottom-color: #2B3D3D; }
.usage-app-symbol { width: 30px; height: 30px; border-radius: 9px; background-color: #29463E; color: #B7E5CF; -unity-text-align: middle-center; font-size: 12px; }
.home-content .usage-app-name { flex-grow: 1; flex-shrink: 1; margin-left: 10px; margin-right: 8px; font-size: 13px; }
.usage-app-time { font-size: 13px; color: #C5FFDE; -unity-font-style: bold; }
.home-content .usage-updated { color: #93AAA5; font-size: 11px; margin-top: 12px; }
.home-inline-button { min-height: 44px; font-size: 13px; margin: 4px 0 0 0; padding: 8px 0; -unity-text-align: middle-left; }
.home-pet-art { width: 62px; height: 62px; flex-shrink: 0; border-radius: 16px; background-color: #253540; justify-content: center; align-items: center; }
.home-pet-icon { width: 28px; height: 28px; color: #9BC7BA; }
#home-pet-image { position: absolute; width: 58px; height: 58px; }
.home-companion-copy { flex-grow: 1; flex-shrink: 1; margin-left: 14px; }
.home-small { font-size: 13px; color: var(--app-text-muted); margin-top: 7px; }
.home-content .home-action { min-height: 46px; font-size: 14px; border-radius: 12px; margin-top: 16px; padding: 10px 12px; white-space: normal; }
.home-pause { background-color: #172225; }
.app--compact .home-heading { font-size: 23px; }
.app--compact .home-card { padding: 14px; }
.app--compact.home-page .content-panel { padding-top: 12px; }
