<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
  <Style src="../Themes/App.uss" />
  <Style src="../Themes/PetCreation.uss" />
  <ui:VisualElement name="app" class="app pet-customization">
    <ui:VisualElement name="safe-area" class="safe-area">
      <ui:VisualElement class="content-panel">
        <ui:Label text="Make them yours" class="page-header" />
        <ui:ScrollView
          name="customization-scroll"
          mode="Vertical"
          horizontal-scroller-visibility="Hidden"
          class="page-scroll"
        >
          <ui:Label
            name="pet-species"
            text="Your new companion"
            class="customization-subtitle"
          />
          <ui:TextField
            name="pet-name-input"
            label="Pet name"
            max-length="24"
            class="pet-name-input"
          />
          <ui:VisualElement
            name="pet-viewport"
            class="pet-viewport"
            focusable="true"
            tooltip="Inspect: drag to pan and pinch to zoom. Draw: drag to paint your pet."
          >
            <ui:Image
              name="pet-preview"
              class="pet-preview"
              picking-mode="Ignore"
            />
            <ui:Label
              name="preview-placeholder"
              text="Your pet will appear here"
              class="preview-placeholder"
              picking-mode="Ignore"
            />
          </ui:VisualElement>
          <ui:VisualElement class="customization-toolbar">
            <ui:Button
              name="inspect-mode"
              text="Inspect"
              class="customization-tool customization-tool--selected"
            />
            <ui:Button
              name="draw-mode"
              text="Draw"
              class="customization-tool"
            />
            <ui:Button
              name="erase-mode"
              text="Erase"
              class="customization-tool"
            />
          </ui:VisualElement>
          <ui:Label
            name="gesture-hint"
            text="Drag to move. Pinch or use + / - to zoom."
            class="customization-hint"
          />
          <ui:VisualElement class="customization-toolbar">
            <ui:Button
              name="zoom-out"
              text="-"
              tooltip="Zoom out"
              class="customization-tool"
            />
            <ui:Button
              name="reset-view"
              text="Reset view"
              class="customization-tool"
            />
            <ui:Button
              name="zoom-in"
              text="+"
              tooltip="Zoom in"
              class="customization-tool"
            />
          </ui:VisualElement>
          <ui:VisualElement name="paint-tools" class="paint-tools">
            <ui:Label text="Brush colour" class="customization-field-label" />
            <ui:VisualElement name="paint-palette" class="paint-palette">
              <ui:Button
                name="colour-green"
                text="G"
                tooltip="Green"
                class="colour-swatch colour-swatch--green colour-swatch--selected"
              />
              <ui:Button
                name="colour-blue"
                text="B"
                tooltip="Blue"
                class="colour-swatch colour-swatch--blue"
              />
              <ui:Button
                name="colour-pink"
                text="P"
                tooltip="Pink"
                class="colour-swatch colour-swatch--pink"
              />
              <ui:Button
                name="colour-yellow"
                text="Y"
                tooltip="Yellow"
                class="colour-swatch colour-swatch--yellow"
              />
              <ui:Button
                name="colour-white"
                text="W"
                tooltip="White"
                class="colour-swatch colour-swatch--white"
              />
              <ui:Button
                name="colour-black"
                text="K"
                tooltip="Black"
                class="colour-swatch colour-swatch--black"
              />
            </ui:VisualElement>
            <ui:Slider
              name="brush-size"
              label="Brush size"
              low-value="2"
              high-value="32"
              value="12"
              show-input-field="true"
            />
          </ui:VisualElement>
          <ui:VisualElement class="customization-toolbar">
            <ui:Button
              name="undo-paint"
              text="Undo"
              class="customization-tool"
            />
            <ui:Button
              name="clear-paint"
              text="Clear drawing"
              class="customization-tool"
            />
          </ui:VisualElement>
          <ui:Label
            name="customization-status"
            text="Give your companion a name to continue."
            class="customization-hint"
          />
          <ui:Button
            name="finish-pet"
            text="Done"
            class="app-button button--primary customization-done"
          />
          <ui:Button
            name="back-to-selection"
            text="Back to pets"
            class="app-button button--text customization-back"
          />
        </ui:ScrollView>
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
